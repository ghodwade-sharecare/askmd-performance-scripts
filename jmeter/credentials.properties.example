# AskMD JMeter credentials TEMPLATE.
# Copy this file to "credentials.properties" (same folder) and fill in real values.
# credentials.properties is git-ignored and must never be committed.
#
# How the scripts read these: each .jmx uses ${__P(name)} to pull the value at runtime.
#
# GUI usage (either one):
#   - Start JMeter with:  jmeter -q <path>/credentials.properties
#   - OR copy these lines into <JMETER_HOME>/bin/user.properties (auto-loaded on GUI launch).
# CLI usage:
#   jmeter -q credentials.properties -n -t askMD_Pricing_API.jmx -l results.jtl

# --- Standard stage Auth0 app (member/insurance/etc. scripts) ---
stage.client_id=
stage.client_secret=

# --- Standard UAT Auth0 app ---
uat.client_id=
uat.client_secret=

# --- API Script (Auth0 Management API) stage app ---
apiscript.stage.client_id=
apiscript.stage.client_secret=

# --- API Script (Auth0 Management API) UAT app ---
apiscript.uat.client_id=
apiscript.uat.client_secret=

# --- Shared test user password (all scripts) ---
test.password=
