        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="AI_Chat_Report_JSONL_Writer" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import java.net.InetAddress
import java.nio.charset.StandardCharsets
import java.nio.file.Files
import java.nio.file.Path
import java.nio.file.Paths
import java.nio.file.StandardOpenOption
import java.time.Instant

/*
 * ============================================================
 * AI_Chat_Report_JSONL_Writer
 * ============================================================
 *
 * Writes a JSONL record per request for the automated
 * performance report generator (generate_report.py).
 *
 * Output: report-results/askmd_report_&lt;runId&gt;_&lt;engine&gt;.jsonl
 *
 * This sampler is independent of the existing
 * &quot;Final Validation and JSONL Writer&quot; which serves
 * a different purpose.
 * ============================================================
 */

// ---- Helpers ----

def toLongSafe = { Object value, long defaultValue = 0L -&gt;
    if (value == null || value.toString().trim().isEmpty()) return defaultValue
    try { return value.toString().toLong() } catch (Exception e) { return defaultValue }
}

def toIsoTimestamp = { Long epochMs -&gt;
    if (epochMs == null || epochMs &lt;= 0L) return null
    return Instant.ofEpochMilli(epochMs).toString()
}

def getLong = { String varName -&gt;
    String v = vars.get(varName)
    if (v == null || v.trim().isEmpty()) return null
    try { return v.toLong() } catch (Exception e) { return null }
}

def copyList = { String varName -&gt;
    Object obj = vars.getObject(varName)
    return obj instanceof List ? new ArrayList((List) obj) : []
}

def copyMap = { String varName -&gt;
    Object obj = vars.getObject(varName)
    return obj instanceof Map ? new LinkedHashMap((Map) obj) : [:]
}

// ---- Timestamps ----

long now = System.currentTimeMillis()

Long requestStart       = getLong(&apos;request_start&apos;)
Long firstProgressTs    = getLong(&apos;first_progress_timestamp&apos;)
Long firstTokenTs       = getLong(&apos;first_token_timestamp&apos;)
Long lastTokenTs        = getLong(&apos;last_token_timestamp&apos;)
Long messageCompleteTs  = getLong(&apos;message_complete_timestamp&apos;)
Long wsOpenTs           = getLong(&apos;websocket_open_timestamp&apos;)

// ---- Derived Timings ----

boolean completed = vars.get(&apos;message_complete_received&apos;) == &apos;true&apos;
Long effectiveEnd = messageCompleteTs ?: now

Long responseTimeMs = requestStart != null
    ? Math.max(0L, effectiveEnd - requestStart) : null

Long timeToFirstProgressMs = (requestStart != null &amp;&amp; firstProgressTs != null)
    ? Math.max(0L, firstProgressTs - requestStart) : null

Long timeToFirstTokenMs = (requestStart != null &amp;&amp; firstTokenTs != null)
    ? Math.max(0L, firstTokenTs - requestStart) : null

Long streamDurationMs = (firstTokenTs != null &amp;&amp; lastTokenTs != null)
    ? Math.max(0L, lastTokenTs - firstTokenTs) : null

Long lastTokenToCompleteMs = (lastTokenTs != null &amp;&amp; messageCompleteTs != null)
    ? Math.max(0L, messageCompleteTs - lastTokenTs) : null

// WebSocket connection time
Long wsConnectionTimeMs = (wsOpenTs != null &amp;&amp; requestStart != null &amp;&amp; wsOpenTs &lt; requestStart)
    ? Math.max(0L, requestStart - wsOpenTs) : null

// Inter-delta gap stats
long interDeltaGapSum   = toLongSafe(vars.get(&apos;inter_delta_gap_sum_ms&apos;), 0L)
long interDeltaGapCount = toLongSafe(vars.get(&apos;inter_delta_gap_count&apos;), 0L)
long maxInterDeltaGap   = toLongSafe(vars.get(&apos;max_inter_delta_gap_ms&apos;), 0L)
Long avgInterDeltaGapMs = interDeltaGapCount &gt; 0
    ? Math.round(interDeltaGapSum / (double) interDeltaGapCount) : null

// ---- LLM Phase Metrics ----

List llmPhases = copyList(&apos;llm_phases&apos;)
List llmDurationsMs = []
long totalLlmDurationMs = 0L
int llmPhaseCount = 0

for (Object phaseObj : llmPhases) {
    if (!(phaseObj instanceof Map)) continue
    Map phase = (Map) phaseObj
    Long dur = phase.get(&apos;llmDurationMs&apos;) != null
        ? toLongSafe(phase.get(&apos;llmDurationMs&apos;), 0L) : null
    long deltaCount = toLongSafe(phase.get(&apos;deltaCount&apos;), 0L)
    if (dur != null || deltaCount &gt; 0) {
        llmPhaseCount++
        if (dur != null &amp;&amp; dur &gt; 0) {
            llmDurationsMs.add(dur)
            totalLlmDurationMs += dur
        }
    }
}

// Final answer TTFT (last phase with text)
Long finalAnswerTtftMs = null
for (int i = llmPhases.size() - 1; i &gt;= 0; i--) {
    Object phaseObj = llmPhases.get(i)
    if (!(phaseObj instanceof Map)) continue
    Map phase = (Map) phaseObj
    Long firstDelta = phase.get(&apos;firstDeltaTimestamp&apos;) != null
        ? toLongSafe(phase.get(&apos;firstDeltaTimestamp&apos;), 0L) : null
    if (firstDelta != null &amp;&amp; firstDelta &gt; 0 &amp;&amp; requestStart != null) {
        finalAnswerTtftMs = Math.max(0L, firstDelta - requestStart)
        break
    }
}

// ---- Tool Metrics ----

List toolCalls = copyList(&apos;tool_calls&apos;)
long toolStartCount = toLongSafe(vars.get(&apos;tool_start_count&apos;), 0L)
long toolEndCount   = toLongSafe(vars.get(&apos;tool_end_count&apos;), 0L)
List toolDurationsMs = []
long totalToolDurationMs = 0L
List toolNames = []
long toolFailureCount = 0L

for (Object toolObj : toolCalls) {
    if (!(toolObj instanceof Map)) continue
    Map tool = (Map) toolObj
    String tName = tool.get(&apos;toolName&apos;)?.toString() ?: &apos;&apos;
    if (tName &amp;&amp; !toolNames.contains(tName)) toolNames.add(tName)

    Long dur = tool.get(&apos;durationMs&apos;) != null
        ? toLongSafe(tool.get(&apos;durationMs&apos;), 0L) : null
    if (dur != null &amp;&amp; dur &gt; 0) {
        toolDurationsMs.add(dur)
        totalToolDurationMs += dur
    }

    String status = tool.get(&apos;status&apos;)?.toString()?.trim() ?: &apos;&apos;
    if (status &amp;&amp; !status.equalsIgnoreCase(&apos;ok&apos;) &amp;&amp;
        !status.equalsIgnoreCase(&apos;success&apos;) &amp;&amp;
        !status.equalsIgnoreCase(&apos;completed&apos;)) {
        toolFailureCount++
    }
}

// Post-tool TTFT
Long lastToolEnd = null
for (Object toolObj : toolCalls) {
    if (!(toolObj instanceof Map)) continue
    Long te = ((Map) toolObj).get(&apos;endTimestamp&apos;) != null
        ? toLongSafe(((Map) toolObj).get(&apos;endTimestamp&apos;), 0L) : null
    if (te != null &amp;&amp; (lastToolEnd == null || te &gt; lastToolEnd)) lastToolEnd = te
}

Long postToolTtftMs = null
if (lastToolEnd != null &amp;&amp; finalAnswerTtftMs != null &amp;&amp; requestStart != null) {
    Long finalAnswerAbsTs = requestStart + finalAnswerTtftMs
    if (finalAnswerAbsTs &gt;= lastToolEnd) {
        postToolTtftMs = finalAnswerAbsTs - lastToolEnd
    }
}

// ---- Counters ----

long totalMessageCount    = toLongSafe(vars.get(&apos;total_message_count&apos;), 0L)
long progressMessageCount = toLongSafe(vars.get(&apos;progress_message_count&apos;), 0L)
long deltaMessageCount    = toLongSafe(vars.get(&apos;delta_message_count&apos;), 0L)
long emptyDeltaCount      = toLongSafe(vars.get(&apos;empty_delta_count&apos;), 0L)
long llmEndCount          = toLongSafe(vars.get(&apos;llm_end_count&apos;), 0L)
long citationCount        = toLongSafe(vars.get(&apos;citation_count&apos;), 0L)
long appErrorCount        = toLongSafe(vars.get(&apos;application_error_count&apos;), 0L)
long malformedCount       = toLongSafe(vars.get(&apos;malformed_message_count&apos;), 0L)
long processingErrCount   = toLongSafe(vars.get(&apos;processing_error_count&apos;), 0L)
long totalResponseBytes   = toLongSafe(vars.get(&apos;total_response_bytes&apos;), 0L)
long loopCount            = toLongSafe(vars.get(&apos;loop_counter&apos;), 0L)

// ---- Status Classification ----

boolean timeout = !completed &amp;&amp; requestStart != null &amp;&amp; (now - requestStart) &gt;= 60000L
boolean readLimitReached = !completed &amp;&amp; loopCount &gt;= 200L

String businessStatus
String technicalStatus

if (!completed || timeout || readLimitReached) {
    businessStatus = &apos;Incomplete&apos;
    technicalStatus = &apos;Failed&apos;
} else if (appErrorCount &gt; 0 || malformedCount &gt; 0 || toolFailureCount &gt; 0) {
    businessStatus = &apos;Completed&apos;
    technicalStatus = &apos;Failed&apos;
} else {
    businessStatus = &apos;Completed&apos;
    technicalStatus = &apos;Passed&apos;
}

// ---- Run Identification ----

String engineName
try { engineName = InetAddress.localHost.hostName }
catch (Exception e) { engineName = &apos;unknown&apos; }

String runId = vars.get(&apos;askmd_run_id&apos;)
if (!runId) {
    String tsMs = props.getProperty(&apos;TESTSTART.MS&apos;) ?: String.valueOf(System.currentTimeMillis())
    long startMs
    try { startMs = tsMs.toLong() } catch (Exception e) { startMs = System.currentTimeMillis() }
    runId = Instant.ofEpochMilli(startMs).toString().replace(&apos;:&apos;, &apos;-&apos;).replace(&apos;.&apos;, &apos;-&apos;)
    vars.put(&apos;askmd_run_id&apos;, runId)
}

// ---- Build JSONL Record ----

Map record = [
    schemaVersion              : &apos;2.0&apos;,
    runId                      : runId,
    timestamp                  : toIsoTimestamp(now),
    timestampEpochMs           : now,
    engine                     : engineName,
    threadName                 : ctx.getThread().getThreadName(),
    threadNumber               : ctx.getThreadNum(),
    threadGroup                : ctx.getThreadGroup().getName(),
    scenario                   : vars.get(&apos;scenario_name&apos;) ?: &apos;Clinical-Reasoning&apos;,
    chatId                     : vars.get(&apos;chat_id&apos;) ?: vars.get(&apos;chatId&apos;) ?: &apos;&apos;,
    question                   : vars.get(&apos;health_question&apos;) ?: &apos;&apos;,

    // WebSocket
    websocketOpenSuccess       : vars.get(&apos;websocket_open_success&apos;) == &apos;true&apos;,
    websocketConnectionTimeMs  : wsConnectionTimeMs,

    // Core timing (ms)
    requestStartTimestampEpochMs : requestStart,
    responseTimeMs             : responseTimeMs,
    timeToFirstProgressMs      : timeToFirstProgressMs,
    timeToFirstTokenMs         : timeToFirstTokenMs,
    finalAnswerTimeToFirstTokenMs : finalAnswerTtftMs,
    postToolTimeToFirstTokenMs : postToolTtftMs,
    streamDurationMs           : streamDurationMs,
    lastTokenToCompleteMs      : lastTokenToCompleteMs,
    averageInterDeltaGapMs     : avgInterDeltaGapMs,
    maxInterDeltaGapMs         : maxInterDeltaGap &gt; 0 ? maxInterDeltaGap : null,

    // LLM metrics
    llmPhaseCount              : llmPhaseCount,
    llmEndCount                : llmEndCount,
    llmDurationsMs             : llmDurationsMs,
    totalLlmDurationMs         : totalLlmDurationMs &gt; 0 ? totalLlmDurationMs : null,

    // Tool/RAG metrics
    toolUsed                   : !toolCalls.isEmpty(),
    toolCallCount              : toolCalls.size(),
    toolStartCount             : toolStartCount,
    toolEndCount               : toolEndCount,
    toolNames                  : toolNames,
    toolDurationsMs            : toolDurationsMs,
    totalToolDurationMs        : totalToolDurationMs &gt; 0 ? totalToolDurationMs : null,
    toolFailureCount           : toolFailureCount,

    // Message counters
    totalMessageCount          : totalMessageCount,
    progressMessageCount       : progressMessageCount,
    messageDeltaCount          : deltaMessageCount,
    emptyDeltaCount            : emptyDeltaCount,
    citationCount              : citationCount,
    totalResponseBytes         : totalResponseBytes,

    // Error counters
    applicationErrorCount      : appErrorCount,
    malformedMessageCount      : malformedCount,
    processingErrorCount       : processingErrCount,

    // Concurrency context
    activeThreadsInGroup       : ctx.getThreadGroup().getNumberOfThreads(),
    activeThreadsTotal         : org.apache.jmeter.threads.JMeterContextService.getTotalThreads(),

    // Status
    messageCompleteReceived    : completed,
    timeout                    : timeout,
    readLimitReached           : readLimitReached,
    businessStatus             : businessStatus,
    technicalStatus            : technicalStatus
]

String jsonLine = JsonOutput.toJson(record)

// ---- Write to File ----

String outputDir = props.getProperty(&apos;report.output.dir&apos;)
if (!outputDir) {
    outputDir = System.getProperty(&apos;user.dir&apos;) + File.separator + &apos;report-results&apos;
}

String safeRunId = runId.replaceAll(&apos;[^A-Za-z0-9._-]&apos;, &apos;_&apos;)
String safeEngine = engineName.replaceAll(&apos;[^A-Za-z0-9._-]&apos;, &apos;_&apos;)
String fileName = &quot;askmd_report_${safeRunId}.jsonl&quot;

Path outputPath = Paths.get(outputDir, fileName)
Path parentDir = outputPath.getParent()
if (parentDir != null) Files.createDirectories(parentDir)

String absPath = outputPath.toAbsolutePath().normalize().toString()
String lockKey = &apos;REPORT_JSONL_LOCK_&apos; + absPath

Object fileLock = props.get(lockKey)
if (fileLock == null) {
    synchronized (props) {
        fileLock = props.get(lockKey)
        if (fileLock == null) {
            fileLock = new Object()
            props.put(lockKey, fileLock)
        }
    }
}

synchronized (fileLock) {
    Files.write(
        outputPath,
        (jsonLine + System.lineSeparator()).getBytes(StandardCharsets.UTF_8),
        StandardOpenOption.CREATE,
        StandardOpenOption.APPEND
    )
}

// ---- Sampler Result ----

SampleResult.setResponseData(jsonLine, &apos;UTF-8&apos;)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(
    &quot;Report JSONL written | TTFT: ${timeToFirstTokenMs ?: &apos;N/A&apos;}ms | &quot; +
    &quot;Response: ${responseTimeMs ?: &apos;N/A&apos;}ms | Status: ${technicalStatus} | &quot; +
    &quot;File: ${absPath}&quot;
)
SampleResult.setSuccessful(true)

log.info(&quot;Report JSONL written to: ${absPath}&quot;)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <eu.luminis.jmeter.wssampler.CloseWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.CloseWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.CloseWebSocketSampler" testname="AI_Chat_04_WebSocket_Close" enabled="true">
          <stringProp name="statusCode">1000</stringProp>
          <stringProp name="readTimeout">20000</stringProp>
        </eu.luminis.jmeter.wssampler.CloseWebSocketSampler>
        <hashTree/>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Think Time" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">2000</stringProp>
        </TestAction>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Pause" enabled="true">
