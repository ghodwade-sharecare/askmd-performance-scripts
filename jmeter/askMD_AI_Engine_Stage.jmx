          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="AI_Chat_02_WebSocket_Request-Response" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

/*
 * ============================================================
 * Helper functions
 * ============================================================
 */

def toLongSafe = {
    Object value,
    long defaultValue = 0L -&gt;

    if (
        value == null ||
        value.toString().trim().isEmpty()
    ) {
        return defaultValue
    }

    try {

        return value
            .toString()
            .toLong()

    } catch (Exception ignored) {

        return defaultValue
    }
}

def toIntSafe = {
    Object value,
    int defaultValue = 0 -&gt;

    if (
        value == null ||
        value.toString().trim().isEmpty()
    ) {
        return defaultValue
    }

    try {

        return value
            .toString()
            .toInteger()

    } catch (Exception ignored) {

        return defaultValue
    }
}

def increment = {
    String variableName,
    long amount = 1L -&gt;

    long currentValue =
        toLongSafe(
            vars.get(variableName),
            0L
        )

    vars.put(
        variableName,
        String.valueOf(
            currentValue + amount
        )
    )
}

/*
 * Find or create an LLM phase.
 */
def getOrCreatePhase = {
    int phaseNumber -&gt;

    Object phaseListObject =
        vars.getObject(&apos;llm_phases&apos;)

    List phases =
        phaseListObject instanceof List
            ? (List) phaseListObject
            : new ArrayList()

    if (!(phaseListObject instanceof List)) {

        vars.putObject(
            &apos;llm_phases&apos;,
            phases
        )
    }

    Map matchedPhase = null

    for (Object phaseObject : phases) {

        if (!(phaseObject instanceof Map)) {
            continue
        }

        Map phase =
            (Map) phaseObject

        int storedPhaseNumber =
            toIntSafe(
                phase.get(&apos;phaseNumber&apos;),
                0
            )

        if (storedPhaseNumber == phaseNumber) {

            matchedPhase = phase
            break
        }
    }

    if (matchedPhase == null) {

        matchedPhase = [
            phaseNumber         : phaseNumber,
            deltaCount          : 0L,
            firstDeltaTimestamp : null,
            lastDeltaTimestamp  : null,
            llmDurationMs       : null,
            llmEndTimestamp     : null,
            deltaParts          : new ArrayList()
        ]

        phases.add(matchedPhase)
    }

    return matchedPhase
}

/*
 * ============================================================
 * Read WebSocket response
 * ============================================================
 */

String response =
    prev.getResponseDataAsString()

response =
    response == null
        ? &apos;&apos;
        : response.trim()

vars.put(
    &apos;last_message&apos;,
    response
)

String samplerName =
    prev.getSampleLabel() ?: &apos;&apos;

/*
 * Increment the read-loop counter only for Single Read.
 */
if (samplerName.contains(&apos;Single_Read&apos;)) {

    increment(&apos;loop_counter&apos;)
}

if (response.isEmpty()) {
    return
}

long receivedTimestamp =
    prev.getEndTime() &gt; 0L
        ? prev.getEndTime()
        : System.currentTimeMillis()

/*
 * ============================================================
 * Early message_complete detection
 * ============================================================
 *
 * This executes before JSON parsing and metric processing.
 */

String compactResponse =
    response.replaceAll(
        &apos;\\s+&apos;,
        &apos;&apos;
    )

if (
    compactResponse.contains(
        &apos;&quot;type&quot;:&quot;message_complete&quot;&apos;
    )
) {

    vars.put(
        &apos;stream_stop&apos;,
        &apos;true&apos;
    )

    vars.put(
        &apos;message_complete_received&apos;,
        &apos;true&apos;
    )

    vars.put(
        &apos;last_message_type&apos;,
        &apos;message_complete&apos;
    )

    vars.put(
        &apos;message_complete_timestamp&apos;,
        String.valueOf(
            receivedTimestamp
        )
    )

    log.info(
        &apos;AskMD message_complete detected from raw response.&apos;
    )
}

increment(
    &apos;total_message_count&apos;
)

increment(
    &apos;total_response_bytes&apos;,
    response.getBytes(&apos;UTF-8&apos;).length
)

/*
 * ============================================================
 * Parse JSON
 * ============================================================
 */

Object parsedResponse

try {

    parsedResponse =
        new JsonSlurper()
            .parseText(response)

} catch (Exception parseException) {

    increment(
        &apos;malformed_message_count&apos;
    )

    log.error(
        &apos;Malformed WebSocket JSON. &apos; +
        &apos;Sampler=&apos; + samplerName +
        &apos;, response=&apos; + response,
        parseException
    )

    return
}

if (!(parsedResponse instanceof Map)) {

    increment(
        &apos;malformed_message_count&apos;
    )

    log.error(
        &apos;WebSocket response is not a JSON object. &apos; +
        &apos;Sampler=&apos; + samplerName +
        &apos;, response=&apos; + response
    )

    return
}

Map json =
    (Map) parsedResponse

String messageType =
    json.get(&apos;type&apos;)
        ?.toString() ?: &apos;unknown&apos;

vars.put(
    &apos;last_message_type&apos;,
    messageType
)

/*
 * ============================================================
 * Dynamic message-type count
 * ============================================================
 */

Object countsObject =
    vars.getObject(
        &apos;message_type_counts&apos;
    )

Map messageTypeCounts =
    countsObject instanceof Map
        ? (Map) countsObject
        : new LinkedHashMap()

if (!(countsObject instanceof Map)) {

    vars.putObject(
        &apos;message_type_counts&apos;,
        messageTypeCounts
    )
}

int currentTypeCount =
    toIntSafe(
        messageTypeCounts.get(messageType),
        0
    )

messageTypeCounts.put(
    messageType,
    currentTypeCount + 1
)

/*
 * ============================================================
 * Process WebSocket message
 * ============================================================
 */

try {

    switch (messageType) {

        case &apos;message_progress&apos;:

            increment(
                &apos;progress_message_count&apos;
            )

            if (
                !vars.get(
                    &apos;first_progress_timestamp&apos;
                )
            ) {

                vars.put(
                    &apos;first_progress_timestamp&apos;,
                    String.valueOf(
                        receivedTimestamp
                    )
                )
            }

            Object progressObject =
                vars.getObject(
                    &apos;progress_events&apos;
                )

            List progressEvents =
                progressObject instanceof List
                    ? (List) progressObject
                    : new ArrayList()

            if (!(progressObject instanceof List)) {

                vars.putObject(
                    &apos;progress_events&apos;,
                    progressEvents
                )
            }

            progressEvents.add([
                timestamp:
                    receivedTimestamp,

                title:
                    json.get(&apos;title&apos;)
                        ?.toString() ?: &apos;&apos;,

                status:
                    json.get(&apos;status&apos;)
                        ?.toString() ?: &apos;&apos;,

                showTimer:
                    json.get(&apos;show_timer&apos;) == true
            ])

            break

        case &apos;message_delta&apos;:

            increment(
                &apos;delta_message_count&apos;
            )

            String delta =
                json.get(&apos;delta&apos;) == null
                    ? &apos;&apos;
                    : json.get(&apos;delta&apos;).toString()

            if (delta.isEmpty()) {

                increment(
                    &apos;empty_delta_count&apos;
                )
            }

            int currentPhaseNumber =
                toIntSafe(
                    vars.get(
                        &apos;current_llm_phase&apos;
                    ),
                    1
                )

            Map currentPhase =
                getOrCreatePhase(
                    currentPhaseNumber
                )

            long phaseDeltaCount =
                toLongSafe(
                    currentPhase.get(
                        &apos;deltaCount&apos;
                    ),
                    0L
                )

            currentPhase.put(
                &apos;deltaCount&apos;,
                phaseDeltaCount + 1L
            )

            if (
                currentPhase.get(
                    &apos;firstDeltaTimestamp&apos;
                ) == null
            ) {

                currentPhase.put(
                    &apos;firstDeltaTimestamp&apos;,
                    receivedTimestamp
                )
            }

            currentPhase.put(
                &apos;lastDeltaTimestamp&apos;,
                receivedTimestamp
            )

            Object deltaPartsObject =
                currentPhase.get(
                    &apos;deltaParts&apos;
                )

            List deltaParts =
                deltaPartsObject instanceof List
                    ? (List) deltaPartsObject
                    : new ArrayList()

            if (!(deltaPartsObject instanceof List)) {

                currentPhase.put(
                    &apos;deltaParts&apos;,
                    deltaParts
                )
            }

            deltaParts.add(delta)

            /*
             * Overall TTFT
             */
            if (
                vars.get(
                    &apos;first_token_received&apos;
                ) != &apos;true&apos;
            ) {

                long requestStart =
                    toLongSafe(
                        vars.get(
                            &apos;request_start&apos;
                        ),
                        0L
                    )

                if (requestStart &gt; 0L) {

                    long ttft =
                        Math.max(
                            0L,
                            receivedTimestamp -
                            requestStart
                        )

                    vars.put(
                        &apos;ttft&apos;,
                        String.valueOf(ttft)
                    )

                    vars.put(
                        &apos;first_token_timestamp&apos;,
                        String.valueOf(
                            receivedTimestamp
                        )
                    )
                }

                vars.put(
                    &apos;first_token_received&apos;,
                    &apos;true&apos;
                )
            }

            vars.put(
                &apos;last_token_timestamp&apos;,
                String.valueOf(
                    receivedTimestamp
                )
            )

            /*
             * Inter-delta gap
             */
            long previousDeltaTimestamp =
                toLongSafe(
                    vars.get(
                        &apos;previous_delta_timestamp&apos;
                    ),
                    0L
                )

            if (previousDeltaTimestamp &gt; 0L) {

                long gap =
                    receivedTimestamp -
                    previousDeltaTimestamp

                if (gap &gt;= 0L) {

                    increment(
                        &apos;inter_delta_gap_sum_ms&apos;,
                        gap
                    )

                    increment(
                        &apos;inter_delta_gap_count&apos;
                    )

                    long currentMaximum =
                        toLongSafe(
                            vars.get(
                                &apos;max_inter_delta_gap_ms&apos;
                            ),
                            0L
                        )

                    if (gap &gt; currentMaximum) {

                        vars.put(
                            &apos;max_inter_delta_gap_ms&apos;,
                            String.valueOf(gap)
                        )
                    }
                }
            }

            vars.put(
                &apos;previous_delta_timestamp&apos;,
                String.valueOf(
                    receivedTimestamp
                )
            )

            break

        case &apos;llm_end&apos;:

            increment(
                &apos;llm_end_count&apos;
            )

            int currentPhaseNumber =
                toIntSafe(
                    vars.get(
                        &apos;current_llm_phase&apos;
                    ),
                    1
                )

            Map currentPhase =
                getOrCreatePhase(
                    currentPhaseNumber
                )

            if (
                json.get(&apos;duration_ms&apos;) != null
            ) {

                currentPhase.put(
                    &apos;llmDurationMs&apos;,
                    toLongSafe(
                        json.get(&apos;duration_ms&apos;),
                        0L
                    )
                )
            }

            currentPhase.put(
                &apos;llmEndTimestamp&apos;,
                receivedTimestamp
            )

            vars.put(
                &apos;current_llm_phase&apos;,
                String.valueOf(
                    currentPhaseNumber + 1
                )
            )

            /*
             * Do not include the pause between phases
             * in token-stream gap metrics.
             */
            vars.put(
                &apos;previous_delta_timestamp&apos;,
                &apos;&apos;
            )

            break

        case &apos;tool_start&apos;:

            increment(
                &apos;tool_start_count&apos;
            )

            Object toolListObject =
                vars.getObject(&apos;tool_calls&apos;)

            List toolCalls =
                toolListObject instanceof List
                    ? (List) toolListObject
                    : new ArrayList()

            if (!(toolListObject instanceof List)) {

                vars.putObject(
                    &apos;tool_calls&apos;,
                    toolCalls
                )
            }

            Map toolInput =
                json.get(&apos;tool_input&apos;)
                    instanceof Map
                    ? new LinkedHashMap(
                        (Map) json.get(
                            &apos;tool_input&apos;
                        )
                    )
                    : [:]

            Map toolCall = [
                toolIndex:
                    toolCalls.size() + 1,

                toolName:
                    json.get(&apos;tool_name&apos;)
                        ?.toString() ?: &apos;&apos;,

                startTimestamp:
                    receivedTimestamp,

                endTimestamp:
                    null,

                durationMs:
                    null,

                status:
                    &apos;&apos;,

                input:
                    toolInput,

                output:
                    [:],

                contentItems:
                    new ArrayList()
            ]

            toolCalls.add(toolCall)

            vars.put(
                &apos;active_tool_index&apos;,
                String.valueOf(
                    toolCalls.size() - 1
                )
            )

            break

        case &apos;message_content&apos;:

            increment(
                &apos;message_content_count&apos;
            )

            Object contentListObject =
                vars.getObject(
                    &apos;content_items&apos;
                )

            List contentItems =
                contentListObject instanceof List
                    ? (List) contentListObject
                    : new ArrayList()

            if (!(contentListObject instanceof List)) {

                vars.putObject(
                    &apos;content_items&apos;,
                    contentItems
                )
            }

            Object toolListObject =
                vars.getObject(&apos;tool_calls&apos;)

            List toolCalls =
                toolListObject instanceof List
                    ? (List) toolListObject
                    : []

            int activeToolIndex =
                toIntSafe(
                    vars.get(
                        &apos;active_tool_index&apos;
                    ),
                    -1
                )

            Object responseContent =
                json.get(&apos;content&apos;)

            if (
                responseContent
                    instanceof Collection
            ) {

                for (
                    Object itemObject :
                    (Collection) responseContent
                ) {

                    if (!(itemObject instanceof Map)) {
                        continue
                    }

                    Map item =
                        (Map) itemObject

                    Map contentSummary = [
                        id:
                            item.get(&apos;id&apos;)
                                ?.toString() ?: &apos;&apos;,

                        score:
                            item.get(&apos;score&apos;),

                        contentType:
                            item.get(&apos;type&apos;)
                                ?.toString() ?: &apos;&apos;,

                        title:
                            item.get(&apos;title&apos;)
                                ?.toString() ?: &apos;&apos;,

                        description:
                            item.get(&apos;description&apos;)
                                ?.toString() ?: &apos;&apos;,

                        url:
                            item.get(&apos;url&apos;)
                                ?.toString() ?: &apos;&apos;,

                        duration:
                            item.get(&apos;duration&apos;)
                    ]

                    contentItems.add(
                        contentSummary
                    )

                    if (
                        activeToolIndex &gt;= 0 &amp;&amp;
                        activeToolIndex &lt;
                            toolCalls.size()
                    ) {

                        Object activeToolObject =
                            toolCalls.get(
                                activeToolIndex
                            )

                        if (
                            activeToolObject
                                instanceof Map
                        ) {

                            Map activeTool =
                                (Map) activeToolObject

                            Object toolContentObject =
                                activeTool.get(
                                    &apos;contentItems&apos;
                                )

                            List toolContentItems =
                                toolContentObject instanceof List
                                    ? (List) toolContentObject
                                    : new ArrayList()

                            if (
                                !(toolContentObject
                                    instanceof List)
                            ) {

                                activeTool.put(
                                    &apos;contentItems&apos;,
                                    toolContentItems
                                )
                            }

                            toolContentItems.add(
                                contentSummary
                            )
                        }
                    }
                }
            }

            break

        case &apos;tool_end&apos;:

            increment(
                &apos;tool_end_count&apos;
            )

            Object toolListObject =
                vars.getObject(&apos;tool_calls&apos;)

            List toolCalls =
                toolListObject instanceof List
                    ? (List) toolListObject
                    : []

            int activeToolIndex =
                toIntSafe(
                    vars.get(
                        &apos;active_tool_index&apos;
                    ),
                    -1
                )

            Map activeTool = null

            if (
                activeToolIndex &gt;= 0 &amp;&amp;
                activeToolIndex &lt;
                    toolCalls.size()
            ) {

                Object activeToolObject =
                    toolCalls.get(
                        activeToolIndex
                    )

                if (
                    activeToolObject
                        instanceof Map
                ) {

                    activeTool =
                        (Map) activeToolObject
                }
            }

            if (activeTool == null) {

                for (
                    int index =
                        toolCalls.size() - 1;
                    index &gt;= 0;
                    index--
                ) {

                    Object candidateObject =
                        toolCalls.get(index)

                    if (
                        !(candidateObject
                            instanceof Map)
                    ) {
                        continue
                    }

                    Map candidate =
                        (Map) candidateObject

                    if (
                        candidate.get(
                            &apos;endTimestamp&apos;
                        ) == null
                    ) {

                        activeTool = candidate
                        break
                    }
                }
            }

            if (activeTool != null) {

                activeTool.put(
                    &apos;endTimestamp&apos;,
                    receivedTimestamp
                )

                activeTool.put(
                    &apos;durationMs&apos;,
                    json.get(&apos;duration_ms&apos;) != null
                        ? toLongSafe(
                            json.get(&apos;duration_ms&apos;),
                            0L
                        )
                        : null
                )

                Map toolOutput =
                    json.get(&apos;tool_output&apos;)
                        instanceof Map
                        ? new LinkedHashMap(
                            (Map) json.get(
                                &apos;tool_output&apos;
                            )
                        )
                        : [:]

                activeTool.put(
                    &apos;output&apos;,
                    toolOutput
                )

                activeTool.put(
                    &apos;status&apos;,
                    toolOutput.get(&apos;status&apos;)
                        ?.toString() ?: &apos;&apos;
                )
            }

            vars.put(
                &apos;active_tool_index&apos;,
                &apos;-1&apos;
            )

            break

        case &apos;message_citation&apos;:

            increment(
                &apos;citation_message_count&apos;
            )

            Object citationListObject =
                vars.getObject(&apos;citations&apos;)

            List capturedCitations =
                citationListObject instanceof List
                    ? (List) citationListObject
                    : new ArrayList()

            if (!(citationListObject instanceof List)) {

                vars.putObject(
                    &apos;citations&apos;,
                    capturedCitations
                )
            }

            Object citationResponseObject =
                json.get(&apos;citations&apos;)

            Collection responseCitations =
                citationResponseObject instanceof Collection
                    ? (Collection) citationResponseObject
                    : []

            increment(
                &apos;citation_count&apos;,
                responseCitations.size()
            )

            for (
                Object citationObject :
                responseCitations
            ) {

                if (!(citationObject instanceof Map)) {
                    continue
                }

                Map citation =
                    (Map) citationObject

                Map source =
                    citation.get(&apos;source&apos;)
                        instanceof Map
                        ? (Map) citation.get(
                            &apos;source&apos;
                        )
                        : [:]

                Collection spans =
                    citation.get(&apos;spans&apos;)
                        instanceof Collection
                        ? (Collection) citation.get(
                            &apos;spans&apos;
                        )
                        : []

                Map firstSpan = [:]

                if (!spans.isEmpty()) {

                    Object firstSpanObject =
                        spans.iterator().next()

                    if (
                        firstSpanObject
                            instanceof Map
                    ) {

                        firstSpan =
                            (Map) firstSpanObject
                    }
                }

                Map location =
                    firstSpan.get(&apos;location&apos;)
                        instanceof Map
                        ? (Map) firstSpan.get(
                            &apos;location&apos;
                        )
                        : [:]

                capturedCitations.add([
                    citationId:
                        citation.get(&apos;id&apos;),

                    sourceId:
                        source.get(&apos;source_id&apos;)
                            ?.toString() ?: &apos;&apos;,

                    sourceType:
                        source.get(&apos;source_type&apos;)
                            ?.toString() ?: &apos;&apos;,

                    title:
                        source.get(&apos;title&apos;)
                            ?.toString() ?: &apos;&apos;,

                    organisation:
                        source.get(&apos;organization&apos;)
                            ?.toString() ?: &apos;&apos;,

                    url:
                        source.get(&apos;url&apos;)
                            ?.toString() ?: &apos;&apos;,

                    heading:
                        location.get(&apos;heading&apos;)
                            ?.toString() ?: &apos;&apos;,

                    sectionId:
                        location.get(&apos;section_id&apos;)
                            ?.toString() ?: &apos;&apos;,

                    icd10Code:
                        location.get(&apos;icd10_code&apos;)
                            ?.toString() ?: &apos;&apos;,

                    conditionName:
                        location.get(&apos;condition_name&apos;)
                            ?.toString() ?: &apos;&apos;,

                    score:
                        location.get(&apos;score&apos;)
                ])
            }

            break

        case &apos;ping&apos;:

            increment(
                &apos;ping_message_count&apos;
            )

            break

        case &apos;pong&apos;:

            increment(
                &apos;pong_message_count&apos;
            )

            break

        case &apos;error&apos;:
        case &apos;message_error&apos;:

            increment(
                &apos;application_error_count&apos;
            )

            vars.put(
                &apos;application_error_received&apos;,
                &apos;true&apos;
            )

            Object errorListObject =
                vars.getObject(
                    &apos;application_errors&apos;
                )

            List applicationErrors =
                errorListObject instanceof List
                    ? (List) errorListObject
                    : new ArrayList()

            if (!(errorListObject instanceof List)) {

                vars.putObject(
                    &apos;application_errors&apos;,
                    applicationErrors
                )
            }

            applicationErrors.add([
                timestamp:
                    receivedTimestamp,

                type:
                    messageType,

                message:
                    json.get(&apos;message&apos;)
                        ?.toString() ?:
                    json.get(&apos;error&apos;)
                        ?.toString() ?:
                    response
            ])

            break

        case &apos;message_complete&apos;:

            vars.put(
                &apos;stream_stop&apos;,
                &apos;true&apos;
            )

            vars.put(
                &apos;message_complete_received&apos;,
                &apos;true&apos;
            )

            vars.put(
                &apos;last_message_type&apos;,
                &apos;message_complete&apos;
            )

            vars.put(
                &apos;message_complete_timestamp&apos;,
                String.valueOf(
                    receivedTimestamp
                )
            )

            log.info(
                &apos;AskMD message_complete received. &apos; +
                &apos;Stopping WebSocket read loop.&apos;
            )

            break

        default:

            increment(
                &apos;unknown_message_count&apos;
            )

            log.warn(
                &apos;Unknown WebSocket message type. &apos; +
                &apos;Type=&apos; + messageType +
                &apos;, response=&apos; + response
            )

            break
    }

} catch (Exception processingException) {

    increment(
        &apos;processing_error_count&apos;
    )

    Object processingErrorListObject =
        vars.getObject(
            &apos;processing_errors&apos;
        )

    List processingErrors =
        processingErrorListObject instanceof List
            ? (List) processingErrorListObject
            : new ArrayList()

    if (
        !(processingErrorListObject
            instanceof List)
    ) {

        vars.putObject(
            &apos;processing_errors&apos;,
            processingErrors
        )
    }

    if (processingErrors.size() &lt; 20) {

        processingErrors.add([
            timestamp:
                receivedTimestamp,

            type:
                messageType,

            exception:
                processingException
                    .getClass()
                    .getName(),

            message:
                processingException
                    .getMessage() ?: &apos;&apos;
        ])
    }

    log.error(
        &apos;WebSocket metric processing error. &apos; +
        &apos;Type=&apos; + messageType +
        &apos;, sampler=&apos; + samplerName +
        &apos;, response=&apos; + response,
        processingException
    )
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="While Controller">
          <stringProp name="WhileController.condition">${__groovy(def stop=(vars.get(&apos;stream_stop&apos;) ?: &apos;false&apos;).equalsIgnoreCase(&apos;true&apos;); def completed=(vars.get(&apos;message_complete_received&apos;) ?: &apos;false&apos;).equalsIgnoreCase(&apos;true&apos;); def lastType=vars.get(&apos;last_message_type&apos;) ?: &apos;&apos;; def loops=(vars.get(&apos;loop_counter&apos;) ?: &apos;0&apos;).toInteger(); def start=(vars.get(&apos;request_start&apos;) ?: &apos;0&apos;).toLong(); return !stop &amp;&amp; !completed &amp;&amp; lastType != &apos;message_complete&apos; &amp;&amp; loops &lt; 1000 &amp;&amp; start &gt; 0L &amp;&amp; (System.currentTimeMillis()-start) &lt; 90000L)}</stringProp>
        </WhileController>
        <hashTree>
          <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="AI_Chat_03_WebSocket_Single_Read_Sampler" enabled="true">
            <boolProp name="TLS">false</boolProp>
            <stringProp name="server"></stringProp>
            <stringProp name="port">80</stringProp>
            <stringProp name="path"></stringProp>
            <stringProp name="dataType">Text</stringProp>
            <boolProp name="createNewConnection">false</boolProp>
            <stringProp name="readTimeout">4000</stringProp>
            <boolProp name="optional">true</boolProp>
            <boolProp name="binaryPayload">false</boolProp>
            <stringProp name="connectTimeout">20000</stringProp>
          </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">current_duration</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.duration_ms</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
