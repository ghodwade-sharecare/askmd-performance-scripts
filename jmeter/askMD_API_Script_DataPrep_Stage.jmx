<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="AUTH0_HOST_UAT" elementType="Argument">
            <stringProp name="Argument.name">AUTH0_HOST_UAT</stringProp>
            <stringProp name="Argument.value">askmd-stage.sharecare-nonprod.auth0app.com</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUDIENCE" elementType="Argument">
            <stringProp name="Argument.name">AUDIENCE</stringProp>
            <stringProp name="Argument.value">stage-askmd-api.sharecare.com</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">askmd-api.stage.sharecare.com</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="scheme" elementType="Argument">
            <stringProp name="Argument.name">scheme</stringProp>
            <stringProp name="Argument.value">https</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="chatId" elementType="Argument">
            <stringProp name="Argument.name">chatId</stringProp>
            <stringProp name="Argument.value">${__UUID}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RSC" elementType="Argument">
            <stringProp name="Argument.name">RSC</stringProp>
            <stringProp name="Argument.value">${__RandomString(16,ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="password" elementType="Argument">
            <stringProp name="Argument.name">password</stringProp>
            <stringProp name="Argument.value">${__P(test.password,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="clearMemberId" elementType="Argument">
            <stringProp name="Argument.name">clearMemberId</stringProp>
            <stringProp name="Argument.value">CL${__RandomString(8,0123456789,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="accessToken" elementType="Argument">
            <stringProp name="Argument.name">accessToken</stringProp>
            <stringProp name="Argument.value">eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IlNyNXl0TDBPSlNRSjRqYVlYel96ZCJ9..fD1s_SGcTmvvse93rqQgph1kCzK_fHyxRBO7gDci0vOjN6hpwAfWHUbzOvaGG2f3TFbaf-D0VRueEyHj-6vhssTkBawTkMon09n9V-A9TIPZqmXnEnwPCKOhKRXZQ_by84ne4pjXE3wEPTfRhanzKA3FVg34ooGbuyy_h_EKDvakhyEGIVtM4MRFjQ2KLSWZ4mQYDSkxA9CHNJaON91q_-tJRUcFsSwWJHxTQO0tedbcxEcgdxKFFEtXsogxDXP206F7BLou9aJKZhVcyiV5urZH4n3JLvSyYPVmdCEs80PzL7kL6KR07E2DiXoSno9DB5UszwGygrgELN8DI2_RPA</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
        <stringProp name="HTTPSampler.protocol">https</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation"></stringProp>
      </ConfigTestElement>
      <hashTree/>
      <CacheManager guiclass="CacheManagerGui" testclass="CacheManager" testname="HTTP Cache Manager">
        <boolProp name="clearEachIteration">false</boolProp>
        <boolProp name="useExpires">true</boolProp>
        <boolProp name="CacheManager.controlledByThread">true</boolProp>
      </CacheManager>
      <hashTree/>
      <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager">
        <collectionProp name="CookieManager.cookies"/>
        <boolProp name="CookieManager.clearEachIteration">false</boolProp>
        <boolProp name="CookieManager.controlledByThreadGroup">true</boolProp>
      </CookieManager>
      <hashTree/>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set Config">
        <stringProp name="filename">stage_userids.csv</stringProp>
        <stringProp name="fileEncoding"></stringProp>
        <stringProp name="variableNames">userId</stringProp>
        <boolProp name="ignoreFirstLine">true</boolProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Submit PAYER Bundle">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="/api/v1/health/fhir/map-2">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">443</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/health/fhir/map</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;userId&quot;:&quot;${userId}&quot;,&quot;primaryPatientId&quot;:&quot;2c5432a9-a07c-4735-bb13-ee331f347d56&quot;,&quot;sourceId&quot;:&quot;payer-aetna-001&quot;,&quot;sourceType&quot;:&quot;PAYER&quot;,&quot;processingMode&quot;:&quot;INITIAL&quot;,&quot;bundleJson&quot;:&quot;{\&quot;resourceType\&quot;:\&quot;Bundle\&quot;,\&quot;type\&quot;:\&quot;collection\&quot;,\&quot;entry\&quot;:[{\&quot;fullUrl\&quot;:\&quot;urn:uuid:2c5432a9-a07c-4735-bb13-ee331f347d56\&quot;,\&quot;resource\&quot;:{\&quot;resourceType\&quot;:\&quot;Patient\&quot;,\&quot;id\&quot;:\&quot;2c5432a9-a07c-4735-bb13-ee331f347d56\&quot;,\&quot;name\&quot;:[{\&quot;use\&quot;:\&quot;official\&quot;,\&quot;family\&quot;:\&quot;Test\&quot;,\&quot;given\&quot;:[\&quot;AAA\&quot;]}],\&quot;gender\&quot;:\&quot;female\&quot;,\&quot;birthDate\&quot;:\&quot;1960-01-01\&quot;}},{\&quot;fullUrl\&quot;:\&quot;urn:uuid:575b547e-5412-4e61-8811-bf20e3d5620d\&quot;,\&quot;resource\&quot;:{\&quot;resourceType\&quot;:\&quot;Condition\&quot;,\&quot;id\&quot;:\&quot;575b547e-5412-4e61-8811-bf20e3d5620d\&quot;,\&quot;clinicalStatus\&quot;:{\&quot;coding\&quot;:[{\&quot;system\&quot;:\&quot;http://terminology.hl7.org/CodeSystem/condition-clinical\&quot;,\&quot;code\&quot;:\&quot;active\&quot;}]},\&quot;code\&quot;:{\&quot;coding\&quot;:[{\&quot;system\&quot;:\&quot;http://snomed.info/sct\&quot;,\&quot;code\&quot;:\&quot;unknown\&quot;,\&quot;display\&quot;:\&quot;Acute pharyngitis\&quot;}]},\&quot;subject\&quot;:{\&quot;reference\&quot;:\&quot;Patient/2c5432a9-a07c-4735-bb13-ee331f347d56\&quot;},\&quot;onsetDateTime\&quot;:\&quot;2024-01-10T00:00:00Z\&quot;,\&quot;recordedDate\&quot;:\&quot;2024-01-10\&quot;,\&quot;note\&quot;:[{\&quot;text\&quot;:\&quot;Acute pharyngitis, diagnosed January 2024.\&quot;}]}},{\&quot;fullUrl\&quot;:\&quot;urn:uuid:f1bc136a-c795-4273-9b35-66049567af41\&quot;,\&quot;resource\&quot;:{\&quot;resourceType\&quot;:\&quot;Condition\&q