          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Write Results To CSV" enabled="false">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">def file = new File(&quot;C:/Projects/ShareCare/Scripts/API/jmeter/payer_crosswalk_results.csv&quot;)

if (!file.exists()) {
    file.append(&quot;payerName,planName,planType,state,totalElements\n&quot;)
}

def payerName = vars.get(&quot;payerName&quot;)
def planName = vars.get(&quot;planName&quot;)
def planType = vars.get(&quot;planType&quot;)
def state = vars.get(&quot;state&quot;)
def totalElements = vars.get(&quot;totalElements&quot;)
if (totalElements == null || totalElements.isEmpty()) {
    totalElements = &quot;0&quot;
}

file.append(&quot;${payerName},${planName},${planType},${state},${totalElements}\n&quot;)

log.info(&quot;Wrote row: ${payerName},${planName},${planType},${state},${totalElements}&quot;)</stringProp>
          </JSR223PostProcessor>
