          <stringProp name="script">vars.put(&quot;last_message&quot;, &quot;START&quot;)
vars.put(&apos;request_start&apos;, String.valueOf(System.currentTimeMillis()))
vars.put(&apos;first_token_received&apos;, &apos;false&apos;)
