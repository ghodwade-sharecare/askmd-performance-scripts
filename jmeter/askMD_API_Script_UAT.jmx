            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">current_duration</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.duration_ms</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def currentVal = vars.get(&quot;current_duration&quot;)

// If we found the duration chunk, save it to a permanent variable
if (currentVal &amp;&amp; currentVal != &quot;NOT_FOUND&quot;) {
    vars.put(&apos;final_llm_duration&apos;, currentVal)
}

int count = Integer.parseInt(vars.get(&quot;loop_counter&quot;)) + 1
vars.put(&quot;loop_counter&quot;, String.valueOf(count))

//To capture response message into last_message variable
//vars.put(&apos;last_message&apos;, prev.getResponseDataAsString().trim())

//Script to calculate ttft - time to first token.

def response = prev.getResponseDataAsString().trim()
vars.put(&apos;last_message&apos;, response)
     if (response.contains(&apos;message_delta&apos;) &amp;&amp; vars.get(&apos;first_token_received&apos;) == &apos;false&apos;) 
     {
         def ttft = System.currentTimeMillis() - vars.get(&apos;request_start&apos;).toLong()
         vars.put(&apos;ttft&apos;, String.valueOf(ttft))
         vars.put(&apos;first_token_received&apos;, &apos;true&apos;)
     }</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="AI_Chat_04_Time_to_First_Token" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">//TTFT Sampler:

def ttft = vars.get(&apos;ttft&apos;)
    if (ttft != null) 
    {
    		SampleResult.setStartTime(SampleResult.getStartTime())
	     SampleResult.setEndTime(SampleResult.getStartTime() + ttft.toLong())
	     SampleResult.setSuccessful(true)
	     SampleResult.setResponseMessage(&quot;TTFT: &quot; + ttft + &quot; ms&quot;)
    }</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="AI_Chat_05_Total_LLM_Response_Time" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">//Final LLM Duration:

def duration = vars.get(&apos;final_llm_duration&apos;)
//log.info(&quot;&gt;&gt;&gt; final_llm_duration value: [&quot; + duration + &quot;]&quot;)

if (duration != null) {

    SampleResult.setStartTime(SampleResult.getStartTime())
    SampleResult.setEndTime(SampleResult.getStartTime() + duration.toLong())
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage(&quot;Total LLM Duration: &quot; + duration + &quot; ms&quot;)	
    
    // Write to file here
    def threadNum = ctx.getThreadNum()
    def timestamp = System.currentTimeMillis()
    def file = new File(&quot;C:/Projects/ShareCare/Scripts/API/Results/llm_durations_${START.YMD}.csv&quot;)
    file.append(&quot;${timestamp},Thread-${threadNum},${duration}\n&quot;)
    
    // Clear variable
    vars.remove(&quot;final_llm_duration&quot;)
} else {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;final_llm_duration not set&quot;)
}</stringProp>
        </JSR223Sampler>
