        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Member_00_Create_New_User_POST" enabled="true">
          <stringProp name="HTTPSampler.port">443</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/auth/callback</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;vendorAuthTokens&quot;: {&#xd;
    &quot;idToken&quot;: &quot;id-test-token&quot;,&#xd;
    &quot;accessToken&quot;: &quot;test-token&quot;&#xd;
  },&#xd;
  &quot;authProvider&quot;: {&#xd;
    &quot;type&quot;: &quot;social&quot;,&#xd;
    &quot;name&quot;: &quot;google&quot;&#xd;
  },&#xd;
  &quot;userProfile&quot;: {&#xd;
    &quot;email&quot;: &quot;${username}&quot;,&#xd;
    &quot;emailVerified&quot;: false,&#xd;
    &quot;name&quot;: &quot;${__RandomString(1,ABCDEFGHIJKLMNOPQRSTUVWXYZ,)}${__RandomString(5,abcdefghijklmnopqrstuwxyz,)}&quot;,&#xd;
    &quot;givenName&quot;: null,&#xd;
    &quot;familyName&quot;: &quot;${__RandomString(1,ABCDEFGHIJKLMNOPQRSTUVWXYZ,)}${__RandomString(7,abcdefghijklmnopqrstuwxyz,)}&quot;,&#xd;
    &quot;picture&quot;: &quot;${scheme}://example.com/avatar/sarah-johnson-12345.jpg&quot;,&#xd;
    &quot;dateOfBirth&quot;: &quot;1980-01-01&quot;,&#xd;
    &quot;phoneNumber&quot;: &quot;+12025551234&quot;,&#xd;
    &quot;phoneNumberVerified&quot;: false,&#xd;
    &quot;address&quot;: {&#xd;
      &quot;street1&quot;: &quot;${street1}&quot;,&#xd;
      &quot;street2&quot;: &quot;${street2}&quot;,&#xd;
      &quot;city&quot;: &quot;${city}&quot;,&#xd;
      &quot;state&quot;: &quot;${state}&quot;,&#xd;
      &quot;postalCode&quot;: &quot;${postcode}&quot;,&#xd;
      &quot;country&quot;: &quot;US&quot;&#xd;
    },&#xd;
    &quot;identityVerification&quot;: {&#xd;
      &quot;identityVerified&quot;: true,&#xd;
      &quot;identityVerificationLevel&quot;: &quot;high&quot;,&#xd;
      &quot;documentVerified&quot;: true,&#xd;
      &quot;biometricVerified&quot;: true,&#xd;
      &quot;verificationTimestamp&quot;: &quot;2024-01-20T10:30:00Z&quot;,&#xd;
      &quot;clearMemberId&quot;: &quot;${clearMemberId}&quot;,&#xd;
      &quot;verificationMethod&quot;: &quot;clearme_biometric&quot;,&#xd;
