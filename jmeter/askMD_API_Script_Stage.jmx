            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// Default values
def defaultQuantity = &quot;50.0&quot;
def defaultNdc = &apos;[&quot;39328003150&quot;,&quot;81033000250&quot;,&quot;83939001104&quot;]&apos;

try {
    def response = prev.getResponseDataAsString()

    if (response == null || response.trim().isEmpty()) {
        log.warn(&quot;Response is null or empty. Using defaults.&quot;)
        vars.put(&quot;quantity&quot;, defaultQuantity)
        vars.put(&quot;ndc&quot;, defaultNdc)
        return
    }

    def json = new JsonSlurper().parseText(response)

    // Safely navigate to quantities - try multiple paths
    def quantities = null

    // Approach 1: If response is nested array [[{...}]]
    if (json instanceof List &amp;&amp; json[0] instanceof List &amp;&amp; json[0][0] != null) {
        quantities = json[0][0]?.results?.getAt(0)?.quantities
    }

    // Approach 2: If response is single array [{...}]
    if (quantities == null &amp;&amp; json instanceof List &amp;&amp; json[0] instanceof Map) {
        quantities = json[0]?.results?.getAt(0)?.quantities
    }

    // Approach 3: If response is direct object {...}
    if (quantities == null &amp;&amp; json instanceof Map) {
        quantities = json?.results?.getAt(0)?.quantities
    }

    if (quantities == null || quantities.isEmpty()) {
        log.warn(&quot;Could not find quantities in response. Using defaults.&quot;)
        vars.put(&quot;quantity&quot;, defaultQuantity)
        vars.put(&quot;ndc&quot;, defaultNdc)
        return
    }

    // Pick a random quantity entry
    def randomIndex = new Random().nextInt(quantities.size())
    def selected = quantities[randomIndex]

    // Extract quantity number
    def quantity = selected.quantity.number.toString()

    // Extract NDC codes (both code systems)
    def ndcCodes = selected.products
        .findAll { it.codeSystem == &quot;2.16.840.1.113883.6.69&quot; || it.codeSystem == &quot;2.16.840.1.113883.6.88&quot; }
        .collect { it.code }

    // Repackager / unit-dose labeler prefixes that usually have no retail pricing.
    // Filtering these out greatly reduces upstream 400s from /drugprice/search.
    def repackagerPrefixes = [&quot;50090&quot;,&quot;55700&quot;,&quot;55289&quot;,&quot;68071&quot;,&quot;68645&quot;,&quot;68788&quot;,
                              &quot;70934&quot;,&quot;71205&quot;,&quot;71335&quot;,&quot;71610&quot;,&quot;63629&quot;,&quot;54868&quot;,
                              &quot;53002&quot;,&quot;43353&quot;,&quot;67296&quot;,&quot;51655&quot;,&quot;60760&quot;,&quot;72189&quot;,
                              &quot;72789&quot;,&quot;70518&quot;,&quot;66116&quot;,&quot;66267&quot;,&quot;70786&quot;,&quot;70010&quot;,
                              &quot;43063&quot;]

    def filteredNdc = ndcCodes.findAll { code -&gt;
        !repackagerPrefixes.any { code.startsWith(it) }
    }

    // If filtering removed everything, fall back to the full list
    if (filteredNdc == null || filteredNdc.isEmpty()) {
        filteredNdc = ndcCodes
    }

    // Send at most 5 NDCs to the pricing endpoint to avoid flooding the vendor
    def limitedNdc = filteredNdc.take(5)

    // If ndcCodes is null or empty, use fallback
    def ndcArray
    if (limitedNdc == null || limitedNdc.isEmpty()) {
        ndcArray = defaultNdc
    } else {
        ndcArray = JsonOutput.toJson(limitedNdc)
    }

    // Store in JMeter variables
    vars.put(&quot;quantity&quot;, quantity)
    vars.put(&quot;ndc&quot;, ndcArray)

    log.info(&quot;Selected quantity: ${quantity}&quot;)
    log.info(&quot;NDC codes: ${ndcArray}&quot;)

} catch (Exception e) {
    log.error(&quot;Error processing response: &quot; + e.getMessage() + &quot;. Using defaults.&quot;)
    vars.put(&quot;quantity&quot;, defaultQuantity)
    vars.put(&quot;ndc&quot;, defaultNdc)
}</stringProp>
