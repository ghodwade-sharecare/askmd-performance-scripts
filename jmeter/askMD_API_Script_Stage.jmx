            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">import java.io.FileWriter
import java.io.BufferedWriter

def RHT_zip_code = vars.get(&quot;RHT_zip_code&quot;)
def sponsorId = vars.get(&quot;sponsorId&quot;)
def sponsorName = vars.get(&quot;sponsorName&quot;)
def isSponsored = vars.get(&quot;isSponsored&quot;)
def termsKey = vars.get(&quot;termsKey&quot;)

def filePath = &quot;C:/Projects/ShareCare/Scripts/API/jmeter/validated_RHT_zip_codes.csv&quot;
def file = new File(filePath)

// Write header if file doesn&apos;t exist
if (!file.exists()) {
    file.text = &quot;RHT_zip_code,sponsorId,sponsorName,isSponsored,termsKey\n&quot;
}

file.append(&quot;${RHT_zip_code},${sponsorId},${sponsorName},${isSponsored},${termsKey}\n&quot;)</stringProp>
          </JSR223PostProcessor>
