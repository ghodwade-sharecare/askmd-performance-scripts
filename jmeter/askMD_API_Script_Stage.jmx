            <stringProp name="script">import java.io.FileWriter
import java.io.BufferedWriter

def email = vars.get(&quot;email&quot;)
def userId = vars.get(&quot;userId&quot;)
def auth0_userId = vars.get(&quot;auth0_userId&quot;)

def filePath = &quot;C:/Projects/ShareCare/Scripts/API/jmeter/registered_users_stage.csv&quot;
def file = new File(filePath)

// Write header if file doesn&apos;t exist
if (!file.exists()) {
    file.text = &quot;email,userId,auth0_userId\n&quot;
}

file.append(&quot;${email},${userId},${auth0_userId}\n&quot;)</stringProp>
